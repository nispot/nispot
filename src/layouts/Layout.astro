---
import '@fontsource-variable/inter';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
interface Props {
  title: string;
  lang?: string;
  canonical?: string;
}

const { title, lang = 'en', canonical } = Astro.props;

// Absolute URLs so crawlers get valid canonical + hreflang signals.
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const enURL = new URL('/en/', Astro.site).href;
const esURL = new URL('/es/', Astro.site).href;
---

<!doctype html lang={lang}>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='description'
      content='Nispot.dev | Nicolás Arichuluaga - Frontend Specialist'
    />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <link rel='canonical' href={canonicalURL} />
    <link rel='alternate' hreflang='en' href={enURL} />
    <link rel='alternate' hreflang='es' href={esURL} />
    <link rel='alternate' hreflang='x-default' href={enURL} />
    <slot name='head' />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Contact />
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  html {
    font-family: 'Inter Variable', sans-serif;
    background: #f4f3ef;
    scroll-behavior: smooth;
  }
  body {
    margin-top: 60px;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>
