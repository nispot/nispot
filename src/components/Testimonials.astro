    photo: {
      src: 'https://media.licdn.com/dms/image/v2/D4E03AQFKhMH1wNIuDw/profile-displayphoto-scale_100_100/B4EZiGC02IGUAg-/0/1754595551167?e=1788393600&v=beta&t=EVgA5XqphyRQ9JGXTNcxcemf4aZNUSerUgOo91oJYHs',
    },
