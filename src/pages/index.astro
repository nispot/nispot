---
import AI from '../components/AI.astro';
import Biography from '../components/Biography.astro';
import Caption from '../components/Caption.astro';
import CompaniesRow from '../components/CompaniesRow.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Projects from '../components/Projects.astro';
import Testimonials from '../components/Testimonials.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title='nispot.dev | Nicolás Arichuluaga - Frontend Specialist'
  lang='en'
  canonical='/en/'
>
  <!--
    The root IS the full site (default locale), so any crawler gets a 200
    with the complete portfolio — nothing to follow. Humans who prefer
    Spanish get nudged to /es/ via JS; bots stay and read the content.
  -->
  <script is:inline slot='head'>
    (function () {
      const stored = localStorage.getItem('preferred-lang');
      const browser =
        navigator.language || navigator.languages?.[0] || 'en';
      const lang = stored || (browser.startsWith('es') ? 'es' : 'en');
      if (lang === 'es') window.location.replace('/es/');
    })();
  </script>

  <Hero />
  <CompaniesRow />
  <Biography />
  <Process />
  <Projects />
  <AI />
  <Caption />
  <Testimonials />
</Layout>
